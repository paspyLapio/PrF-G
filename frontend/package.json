{
  "name": "prf-g-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "build:worker": "tsc -b && tsc -p worker && vite build --mode worker",
    "dev:worker": "cd .. && wrangler dev",
    "deploy": "cd .. && wrangler deploy"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261115.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "lenis": "^1.3.27",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "wrangler": "^4.162.0"
  }
}
